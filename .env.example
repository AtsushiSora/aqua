# AquaNote production environment example.
# Do not put real secrets in git. Copy values into Netlify environment variables.

# Public Supabase URL used by server functions.
SUPABASE_URL=https://your-project.supabase.co

# Server-only key for notification delivery and other backend jobs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI analysis through an OpenAI-compatible Netlify AI Gateway endpoint.
OPENAI_BASE_URL=https://your-openai-compatible-gateway.example.com
OPENAI_API_KEY=optional-api-key
AI_ANALYSIS_MODEL=gpt-4o-mini

# Notification delivery starts as dry-run. Set to false only during final production rehearsal.
NOTIFICATION_DELIVERY_DRY_RUN=true

# Optional email notifications.
RESEND_API_KEY=your-resend-api-key
NOTIFICATION_EMAIL_FROM=AquaNote <notifications@example.com>

# Web Push. Generate with: node scripts/generate-vapid-keys.mjs
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
WEB_PUSH_VAPID_PUBLIC_KEY=your-vapid-public-key
WEB_PUSH_VAPID_PRIVATE_KEY=your-vapid-private-key
WEB_PUSH_TTL_SECONDS=86400

# Optional external Push relay instead of VAPID.
WEB_PUSH_ENDPOINT=
WEB_PUSH_TOKEN=
